# --- Telegram-бот (Docker) ---
TELEGRAM_BOT_TOKEN=put_your_token_here
ML_SERVICE_URL=http://host.docker.internal:8000
ML_REQUEST_TIMEOUT=120
MAX_AUDIO_SECONDS=120

# --- ML-сервис (хост) -- читаются ml_service/server.py при uvicorn ---
# ML_DEVICE=cuda
# ML_ASR_SIZE=tiny
# ML_ASR_COMPUTE=int8
# ML_ASR_BACKEND=faster                     # faster | transformers (нужен для LoRA-адаптера Whisper)
# ML_ASR_ADAPTER=                           # путь до Whisper LoRA-адаптера
# ML_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# ML_LLM_QUANT=int4                         # int4 / int8 / none
# ML_LLM_ADAPTER=.\checkpoints\qwen-grid\best_adapter   # путь до LoRA-адаптера LLM
# LLM_FP16_FALLBACK=0                       # =1 если адаптер от старой peft не грузится на INT4-базу
# HF_TOKEN=hf_...                           # нужен для gated моделей
